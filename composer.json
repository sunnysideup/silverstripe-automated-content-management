{
  "name": "sunnysideup/automated-content-management",
  "description": "Use AI / LLM (like chatGPT) to manage your content.",
  "type": "silverstripe-vendormodule",
  "keywords": [
    "chatgpt",
    "chat gpt",
    "openai",
    "open ai",
    "lama",
    "llama",
    "claude",
    "ai",
    "llm",
    "content management",
    "cms",
    "content editor",
    "automation",
    "automated"
  ],
  "license": "BSD-3-Clause",
  "require": {
    "silverstripe/framework": "^5.0",
    "silverstripe/admin": "^2.0",
    "sunnysideup/ai-llm-connector": "5.x-dev",
    "sunnysideup/classes-and-fields-info": "5.x-dev",
    "sunnysideup/selections": "5.x-dev",
    "sunnysideup/add-casted-variables": "5.x-dev",
    "sunnysideup/optionsetfield-grouped": "5.x-dev",
    "sunnysideup/yes-no-any-filter": "5.x-dev"
  },
  "suggest": {
    "openai-php/client": "Allows using OpenAI models, see sunnysideup/ai-llm-connector",
    "mozex/anthropic-php": "Allows using Anthropic Claude models, see sunnysideup/ai-llm-connector",
    "google-gemini-php/client": "Allows using Google Gemini models, see sunnysideup/ai-llm-connector"
  },
  "require-dev": {
    "sunnysideup/sswebpack_engine_only": "5.x-dev",
    "silverleague/ideannotator": "*",
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.7",
    "silverstripe/standards": "^1",
    "phpstan/extension-installer": "^1.3"
  },
  "autoload": {
    "psr-4": {
      "Sunnysideup\\AutomatedContentManagement\\": "src/"
    }
  },
  "extra": {
    "expose": [
      "client/dist"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "bin": [],
  "authors": [
    {
      "name": "Nicolaas Thiemen Francken",
      "email": "modules@sunnysideup.co.nz",
      "role": "lead developer"
    }
  ]
}
